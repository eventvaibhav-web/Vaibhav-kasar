<style>
  /* =========================================================
     Gift Guide Hero — section styles
     ========================================================= */

  .gift-guide-hero {
    position: relative;
    width: 100%;
  }

  /* ---------- Header ---------- */

  .gift-guide-hero__header {
    width: 100%;
  }

  .gift-guide-hero__header-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 24px;
  }

  .gift-guide-hero__logo img {
    display: block;
    width: auto;
    max-width: 100%;
  }

  .gift-guide-hero__logo-text {
    font-weight: 700;
    letter-spacing: 0.08em;
    font-size: 16px;
    white-space: nowrap;
  }

  .gift-guide-hero__header-text {
    margin: 0;
    font-size: 14px;
    text-align: center;
    flex: 1 1 auto;
    font-family: Jost;
font-weight: 400;
font-style: Regular;
font-size: 16px;
leading-trim: NONE;
line-height: 13.42px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;
color: #000;

  }

  /* ---------- Shared Hover-Fill Animation Structure ---------- */

  .gift-guide-hero__header-btn,
  .gift-guide-hero__cta {
    position: relative;
    overflow: hidden;
    z-index: 0;
   font-family: Jost;
font-weight: 400;
font-style: Regular;
font-size: 16px;
leading-trim: NONE;
line-height: 20.48px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;
text-transform: uppercase;
text-decoration: none;

  }

  .gift-guide-hero__header-btn-label,
  .gift-guide-hero__header-btn-arrow,
  .gift-guide-hero__cta-label,
  .gift-guide-hero__cta-arrow {
    position: relative;
    z-index: 2;
    transition: color 0.35s ease;
    display: flex;
  }

  .gift-guide-hero__header-btn::before,
  .gift-guide-hero__cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    transform: translateX(101%); /* Default RTL: Right to Left fill */
    transition: transform 0.35s ease;
  }

  .gift-guide-hero__header-btn:hover::before,
  .gift-guide-hero__cta:hover::before {
    transform: translateX(0);
  }

  /* Left to right fill (LTR) */
  .gift-guide-hero[data-anim-direction="ltr"] .gift-guide-hero__header-btn::before,
  .gift-guide-hero[data-anim-direction="ltr"] .gift-guide-hero__cta::before {
    transform: translateX(-100%);
  }

  .gift-guide-hero[data-anim-direction="ltr"] .gift-guide-hero__header-btn:hover::before,
  .gift-guide-hero[data-anim-direction="ltr"] .gift-guide-hero__cta:hover::before {
    transform: translateX(0);
  }

  /* ---------- 1. CHOOSE GIFT BUTTON (Base Yellow -> Hover Black) ---------- */

  .gift-guide-hero__header-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11.67px 41px;
    white-space: nowrap;
    background-color: #FFF544;
    color: #111111;
  }

  .gift-guide-hero__header-btn::before {
    background-color: #111111;
  }

  .gift-guide-hero__header-btn:hover .gift-guide-hero__header-btn-label,
  .gift-guide-hero__header-btn:hover .gift-guide-hero__header-btn-arrow {
    color: #ffffff;
  }

  /* ---------- Content area ---------- */

  .gift-guide-hero__content {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* Wraps the background image(s) together with the mobile overlay
     CTA duplicate (see markup below), so that duplicate can be
     centered precisely over the image itself — regardless of how
     tall the text block above it ends up being — instead of being
     positioned relative to the whole (text + image) content area. */
  .gift-guide-hero__media {
    position: relative;
    width: 100%;
  }

  .gift-guide-hero__bg-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .gift-guide-hero__bg-image--placeholder {
    background-color: #e9e9e9;
  }

  .gift-guide-hero__bg-image--mobile {
    display: none;
  }

  .gift-guide-hero__text-block {
    position: absolute;
    bottom: -8%;
    left: 3%;
    transform: translateY(-50%);
    max-width: 460px;
    z-index: 2;
  }

  .gift-guide-hero__heading {
    margin: 0;
    font-size: clamp(32px, 5vw, 70px);
    font-weight: 700;
    line-height: 1.05;
  }

  .gift-guide-hero__description {
    margin: 50px 0 24px;
    font-family: Jost;
font-weight: 400;
font-style: Regular;
font-size: 20px;
leading-trim: NONE;
line-height: 140%;
letter-spacing: 0px;
vertical-align: middle;
color: #000;

  }

  /* ---------- 2. SHOP NOW CTA BUTTON (Base Black -> Hover Yellow) ---------- */

  .gift-guide-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 60px;
    background-color: #111111;
    color: #ffffff;
  }

  .gift-guide-hero__cta::before {
    background-color: #F4D941;
  }

  .gift-guide-hero__cta:hover .gift-guide-hero__cta-label,
  .gift-guide-hero__cta:hover .gift-guide-hero__cta-arrow {
    color: #111111;
  }

  /* The overlay duplicate only ever appears on mobile */
  .gift-guide-hero__cta--overlay {
    display: none;
  }



   /* ---------- Bottom grey box css  ---------- */

.bottom-banner-fotter__box { height: 34px; background-color: {{ section.settings.header_bg_color }}; display: flex; align-items: center;  justify-content: center;  }
.bottom-banner-fotter__box .bottom_txt { font-family: Jost;
font-weight: 400;
font-style: Regular;
font-size: 16px;
leading-trim: NONE;
line-height: 13.42px;
letter-spacing: 0px;
text-align: center;
vertical-align: middle;
color: #000;
 }


  /* ---------- Mobile Responsiveness ---------- */

  @media screen and (max-width: 749px) {
    .gift-guide-hero__header-inner {
      padding: 14px 16px;
      flex-wrap: wrap;
    }

    
  .gift-guide-hero__description {
    margin: 0; font-size: 16px; }

    .gift-guide-hero__header-text {
      order: 3;
      width: 100%;
      text-align: left;
      font-size: 12px;
    }

    .gift-guide-hero[data-hide-header-text-mobile="true"] .gift-guide-hero__header-text {
      display: none;
    }

    /* Stacked mobile layout: heading + description first, then the
       image with "SHOP NOW" centered on top of it — matching the
       target design exactly, instead of overlaying text on the
       image like desktop does. */
    .gift-guide-hero[data-stack-mobile="true"] .gift-guide-hero__content {
      display: flex;
      flex-direction: column;
    }

    .gift-guide-hero[data-stack-mobile="true"] .gift-guide-hero__text-block {
      position: static;
      transform: none;
      max-width: 100%;
      padding: 24px 16px;
      order: 1;
      text-align: center;
    }

    .gift-guide-hero[data-stack-mobile="true"] .gift-guide-hero__media {
      order: 2;
    }

    /* The CTA that lives inside the text block is desktop-only once
       stacked — the overlay duplicate below takes its place. */
    .gift-guide-hero[data-stack-mobile="true"] .gift-guide-hero__text-block .gift-guide-hero__cta--in-text {
      display: none;
    }

    .gift-guide-hero[data-stack-mobile="true"] .gift-guide-hero__cta--overlay {
      display: inline-flex;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 3;
      white-space: nowrap;
    }

    .gift-guide-hero__bg-image--mobile {
      display: block;
    }

    .gift-guide-hero__content:has(.gift-guide-hero__bg-image--mobile) .gift-guide-hero__bg-image--desktop {
      display: none;
    }

    .gift-guide-hero__heading {
      font-size: 28px;
    }
       /* ---------- Bottom grey box css  ---------- */
       .bottom-banner-fotter__box .bottom_txt { font-size: 14px; }
  }
</style>

<section class="gift-guide-hero" id="gift-guide-hero-{{ section.id }}"
    data-hide-header-text-mobile="{{ section.settings.hide_header_text_mobile }}"
    data-stack-mobile="{{ section.settings.stack_text_below_image_mobile }}"
    data-anim-direction="{{ section.settings.anim_direction }}">

    {% comment %} ===== Header ===== {% endcomment %}
    <header class="gift-guide-hero__header" style="background-color: {{ section.settings.header_bg_color }};">
        <div class="gift-guide-hero__header-inner">

            <div class="gift-guide-hero__logo">
                {% if section.settings.logo_image != blank %}
                <img src="{{ section.settings.logo_image | image_url: width: 300 }}"
                    alt="{{ section.settings.logo_text | default: shop.name }}"
                    style="height: {{ section.settings.logo_height }}px;" loading="lazy">
                {% else %}
                <span class="gift-guide-hero__logo-text">{{ section.settings.logo_text }}</span>
                {% endif %}
            </div>

            <p class="gift-guide-hero__header-text">{{ section.settings.header_text }}</p>

            {% if section.settings.button_text != blank %}
            <a href="{{ section.settings.button_link | default: '#' }}" class="gift-guide-hero__header-btn">
                <span class="gift-guide-hero__header-btn-label">{{ section.settings.button_text }}</span>
                <span class="gift-guide-hero__header-btn-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 512 512">
                        <path d="M0 0h512v512H0z" fill="none" />
                        <path fill="currentColor"
                            d="m359.873 121.377l-22.627 22.627l95.997 95.997H16v32.001h417.24l-95.994 95.994l22.627 22.627L494.498 256z" />
                    </svg>

                </span>
            </a>
            {% endif %}

        </div>
    </header>

    {% comment %} ===== Hero content: height driven purely by the background image ===== {% endcomment %}
    <div class="gift-guide-hero__content">

        {% comment %}
        Media wrapper: holds the background image(s) plus a duplicate
        of the CTA button that only ever renders on mobile in stacked
        mode (see CSS). Wrapping them together lets that duplicate be
        centered exactly on the image itself, since `position: relative`
        lives right here rather than on the whole content area.
        {% endcomment %}
        <div class="gift-guide-hero__media">

            {% comment %} This img sets the section's height. It is a placeholder until the real image is uploaded in
            the section settings. {% endcomment %}
            {% if section.settings.background_image != blank %}
            <img src="{{ section.settings.background_image | image_url: width: 2000 }}" srcset="{{ section.settings.background_image | image_url: width: 750 }} 750w,
                  {{ section.settings.background_image | image_url: width: 1100 }} 1100w,
                  {{ section.settings.background_image | image_url: width: 1500 }} 1500w,
                  {{ section.settings.background_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt=""
                class="gift-guide-hero__bg-image gift-guide-hero__bg-image--desktop"
                width="{{ section.settings.background_image.width }}"
                height="{{ section.settings.background_image.height }}" loading="lazy">
            {% else %}
            {% comment %} Fallback placeholder illustration if no image is picked yet {% endcomment %}
            <img src="{{ 'placeholder-svg.svg' | asset_url }}" alt=""
                class="gift-guide-hero__bg-image gift-guide-hero__bg-image--desktop gift-guide-hero__bg-image--placeholder"
                loading="lazy" width="" height="">
            {% endif %}

            {% if section.settings.background_image_mobile != blank %}
            <img src="{{ section.settings.background_image_mobile | image_url: width: 900 }}" alt=""
                class="gift-guide-hero__bg-image gift-guide-hero__bg-image--mobile"
                width="{{ section.settings.background_image_mobile.width }}"
                height="{{ section.settings.background_image_mobile.height }}" loading="lazy">
            {% endif %}

            {% if section.settings.cta_text != blank %}
            <a href="{{ section.settings.cta_link | default: '#' }}"
                class="gift-guide-hero__cta gift-guide-hero__cta--overlay">
                <span class="gift-guide-hero__cta-label">{{ section.settings.cta_text }}</span>
                <span class="gift-guide-hero__cta-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 512 512">
                        <path d="M0 0h512v512H0z" fill="none" />
                        <path fill="currentColor"
                            d="m359.873 121.377l-22.627 22.627l95.997 95.997H16v32.001h417.24l-95.994 95.994l22.627 22.627L494.498 256z" />
                    </svg>

                </span>
            </a>
            {% endif %}

        </div>

        <div class="gift-guide-hero__text-block">
            {% if section.settings.heading != blank %}
            <h1 class="gift-guide-hero__heading">{{ section.settings.heading }}</h1>
            {% endif %}

            {% if section.settings.description != blank %}
            <div class="gift-guide-hero__description">{{ section.settings.description }}</div>
            {% endif %}

            {% if section.settings.cta_text != blank %}
            <a href="{{ section.settings.cta_link | default: '#' }}"
                class="gift-guide-hero__cta gift-guide-hero__cta--in-text">
                <span class="gift-guide-hero__cta-label">{{ section.settings.cta_text }}</span>
                <span class="gift-guide-hero__cta-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 512 512">
                        <path d="M0 0h512v512H0z" fill="none" />
                        <path fill="currentColor"
                            d="m359.873 121.377l-22.627 22.627l95.997 95.997H16v32.001h417.24l-95.994 95.994l22.627 22.627L494.498 256z" />
                    </svg>

                </span>
            </a>
            {% endif %}
        </div>

    </div>

    <div class="bottom-banner-fotter__box"> <span class="bottom_txt">{{ section.settings.bottom_text }}</span> </div>


</section>

{% schema %}
{
  "name": "Gift Guide Hero",
  "settings": [
    {
      "type": "header",
      "content": "Header row"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header background color",
      "default": "#F2F2F2"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image (optional, overrides logo text)"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo image height (px)",
      "min": 16,
      "max": 100,
      "step": 2,
      "default": 32
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header center text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Header button text",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Header button link"
    },
    {
      "type": "header",
      "content": "Background illustration"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)",
      "info": "Section height is driven by this image's own height. Currently showing a placeholder until an image is uploaded here."
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile, optional)",
      "info": "If left empty, the desktop image is used on mobile too."
    },
    {
      "type": "header",
      "content": "Text content (left side, over the image)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    },
    {
      "type": "header",
      "content": "Button hover animation"
    },
    {
      "type": "select",
      "id": "anim_direction",
      "label": "Hover fill direction (applies to both buttons)",
      "options": [
        {
          "value": "rtl",
          "label": "Right to left"
        },
        {
          "value": "ltr",
          "label": "Left to right"
        }
      ],
      "default": "rtl"
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "range",
      "id": "mobile_text_align",
      "label": "Mobile text block position",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 0,
      "info": "0 = left, 1 = center (used as a data attribute; see CSS)"
    },
    {
      "type": "checkbox",
      "id": "hide_header_text_mobile",
      "label": "Hide header center text on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "stack_text_below_image_mobile",
      "label": "On mobile, place text block below the image instead of overlaying it",
      "default": true
    },

    {
      "type": "header",
      "content": "Banner Footer settings"
    },

    {
        "type": "text",
        "id": "bottom_text",
        "label": "bottom grey footer text",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Hero"
    }
  ]
}
{% endschema %}

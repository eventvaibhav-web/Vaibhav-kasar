{{ 'component-tisso-vision-grid.css' | asset_url | stylesheet_tag }}



<div class="tisso-grid-section" id="TissoGrid-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="tisso-grid-section__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="tisso-grid" data-tisso-grid>
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      <div
        class="tisso-grid__item"
        style="--dot-top: {{ block.settings.dot_top | default: 15 }}%; --dot-left: {{ block.settings.dot_left | default: 85 }}%;"
        {{ block.shopify_attributes }}
      >
        {%- if product != blank -%}
          {%- assign img = product.featured_media.preview_image | default: product.featured_image -%}
          {%- if img != blank -%}
            <img
              class="tisso-grid__image"
              src="{{ img | image_url: width: 700 }}"
              srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 750px) 33vw, 50vw"
              alt="{{ img.alt | default: product.title | escape }}"
              loading="lazy"
              width="{{ img.width }}"
              height="{{ img.height }}"
            >
          {%- else -%}
            <div class="tisso-grid__image tisso-grid__image--placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}

          <button
            type="button"
            class="tisso-grid__hotspot"
            aria-label="{{ 'products.product.view_details' | t: default: 'View product details' }} — {{ product.title | escape }}"
            data-tisso-open-popup
            data-product-handle="{{ product.handle }}"
            data-product-url="{{ product.url }}"
          >
            <span aria-hidden="true">+</span>
          </button>

          {%- comment -%}
            Fallback JSON (used if the async fetch below fails for any
            reason, e.g. offline). The primary path fetches
            /products/{handle}.js at click time instead of relying on
            this embedded script, because the theme editor's live
            preview can strip/blank script-tag content on re-render,
            which previously caused "Cannot read properties of
            undefined (reading 'find')" when opening the popup.
          {%- endcomment -%}
          <script type="application/json" data-tisso-product-json="{{ product.handle }}">
            {{ product | json | replace: '</script', '<\/script' }}
          </script>
        {%- else -%}
          <div class="tisso-grid__image tisso-grid__image--placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            <p class="tisso-grid__placeholder-text">{{ 'sections.tisso_vision_grid.select_product' | t: default: 'Select a product in the theme customizer' }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<!--
  Popup / Quick-view modal (single instance, reused for every block).
  Hidden by default via [hidden]; JS toggles it and fills content.
-->
<div class="tisso-popup" data-tisso-popup hidden>
  <div class="tisso-popup__overlay" data-tisso-popup-close></div>
  <div class="tisso-popup__panel" role="dialog" aria-modal="true" aria-labelledby="TissoPopupTitle-{{ section.id }}">
    <button type="button" class="tisso-popup__close" data-tisso-popup-close aria-label="{{ 'accessibility.close' | t: default: 'Close' }}">&times;</button>

    <div class="tisso-popup__media">
      <img data-tisso-popup-image src="" alt="" >

      <div> <h3 id="TissoPopupTitle-{{ section.id }}" class="tisso-popup__title" data-tisso-popup-title></h3>
      <p class="tisso-popup__price" data-tisso-popup-price></p>
      <p class="tisso-popup__description" data-tisso-popup-description></p></div>
    </div>

    <div class="tisso-popup__body">
     

      <form data-tisso-popup-form>
        <div class="tisso-popup__options" data-tisso-popup-options>
          <!-- Option selects are injected here dynamically by JS -->
        </div>

        <p class="tisso-popup__error" data-tisso-popup-error hidden></p>

        <button type="submit" class="tisso-popup__submit" data-tisso-popup-submit>
          <span data-tisso-submit-text>{{ 'products.product.add_to_cart' | t: default: 'ADD TO CART' }}</span>
          <span aria-hidden="true" class="tisso-popup__submit-arrow">&rarr;</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script src="{{ 'tisso-vision-grid.js' | asset_url }}" defer="defer"></script>
<script>
  // Section-level configuration handed to the external JS file.
  // Kept minimal and JSON-safe; avoids inline business logic per
  // Shopify CSP best practice of using asset files for real logic.
  window.tissoVisionGridSettings = window.tissoVisionGridSettings || {};
  window.tissoVisionGridSettings['{{ section.id }}'] = {
    autoAddTrigger: {
      optionValues: ['Black', 'Medium'], // color + size that trigger the auto-add
      productHandle: {{ section.settings.auto_add_product.handle | default: '' | json }}
    },
    moneyFormat: {{ shop.money_format | json }},
    cartUrl: {{ routes.cart_url | json }},
    cartAddUrl: '{{ routes.cart_add_url }}.js',
    cartUpdateUrl: '{{ routes.cart_url }}.js'
  };
</script>

{% schema %}
{
  "name": "Tisso vision grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    },
    {
      "type": "product",
      "id": "auto_add_product",
      "label": "Auto-add product (Black / Medium trigger)",
      "info": "This product is added automatically when a shopper adds a Black + Medium variant of any block product."
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product block",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "dot_top",
          "label": "Dot position \u2014 top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 15
        },
        {
          "type": "range",
          "id": "dot_left",
          "label": "Dot position \u2014 left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 85
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Tisso vision grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}
